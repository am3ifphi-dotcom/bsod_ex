{
  "name": "bsod_ex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BSOD_EX — first-person short horror/glitch experience (room -> BSOD -> glitched world -> collapse -> return)",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "setup": "npm install && npm run fetch-assets",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/smoke-test.mjs"
  },
  "dependencies": {
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/three": "0.171.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  }
}
