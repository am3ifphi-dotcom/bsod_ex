{
  "name": "bsod-ex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BSOD:EX - a first-person short horror / glitch experience",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets:fetch": "node tools/fetch-assets.mjs",
    "assets:optimize": "node tools/optimize-assets.mjs",
    "assets": "npm run assets:fetch && npm run assets:optimize",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@sparticuz/chromium": "^141.0.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.56.0",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
