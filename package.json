{
  "name": "bsod-ex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BSOD // EX \u2014 a first-person short horror / glitch experience",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "textures": "node scripts/gen-textures.mjs",
    "assets:all": "npm run assets:fetch && npm run assets:optimize && npm run textures && npm run assets:verify && npm run credits",
    "credits": "node scripts/gen-credits.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@types/node": "^22.10.2",
    "@types/three": "0.186.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
